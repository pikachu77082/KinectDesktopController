<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- We target x64 because Kinect SDK native DLLs are sensitive to architecture, x64 is best for performance -->
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Microsoft.Kinect">
      <HintPath>C:\Windows\Microsoft.NET\assembly\GAC_64\Microsoft.Kinect\v4.0_2.0.0.0__31bf3856ad364e35\Microsoft.Kinect.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="Microsoft.Kinect.Face">
      <HintPath>C:\Program Files\Microsoft SDKs\Kinect\v2.0_1409\Redist\Face\x64\Microsoft.Kinect.Face.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Speech" Version="10.0.10" />
  </ItemGroup>

  <!-- Post-build event to copy NuiDatabase for Face Tracking -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="xcopy &quot;C:\Program Files\Microsoft SDKs\Kinect\v2.0_1409\Redist\Face\x64\NuiDatabase&quot; &quot;$(TargetDir)NuiDatabase&quot; /e /y /i /r" />
    <Exec Command="xcopy &quot;C:\Program Files\Microsoft SDKs\Kinect\v2.0_1409\Redist\Face\x64\Kinect20.Face.dll&quot; &quot;$(TargetDir)&quot; /c /y" />
  </Target>

</Project>
