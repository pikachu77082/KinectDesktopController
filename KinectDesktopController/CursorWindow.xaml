<Window x:Class="KinectDesktopController.CursorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CursorWindow" 
        WindowState="Maximized"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        IsHitTestVisible="False"
        Loaded="Window_Loaded">
    <Canvas x:Name="CursorCanvas" IsHitTestVisible="False" Visibility="Hidden">
        <Grid x:Name="CursorGrid" Width="80" Height="80" Margin="-40,-40,0,0">
            <Ellipse x:Name="FeedbackRing" Stroke="Cyan" StrokeThickness="4" Width="80" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            <Ellipse x:Name="InnerCursor" Fill="White" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Grid>
    </Canvas>
</Window>
