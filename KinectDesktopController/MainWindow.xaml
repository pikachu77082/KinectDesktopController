<Window x:Class="KinectDesktopController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kinect Desktop Controller" 
        Width="160" Height="120"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        Loaded="Window_Loaded">
    <Grid>
        <!-- The Shadow Overlay -->
        <Image x:Name="ShadowImage" Stretch="Fill" Opacity="0.8" />
        
        <TextBlock x:Name="StatusText" Foreground="White" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="2" Background="#80000000" Padding="2"/>
    </Grid>
</Window>
